{
  "name": "@moritzvitt/quartz-contribute",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js"
  },
  "quartz": {
    "name": "contribute",
    "displayName": "Contribute",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
