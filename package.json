{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackyzha0/quartz.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "sync-zettel": "node scripts/sync-zettel.mjs",
    "configure-site-url": "node scripts/configure-site-url.mjs",
    "dev": "npm run build:plugins && node scripts/use-local-graph.mjs && npm run sync-zettel && npm run ensure-plugin-index && npx quartz build --serve",
    "build": "npm run sync-zettel && npm run ensure-plugin-index && npx quartz build",
    "build:plugins": "npm run build:graph && npm run build:contribute && npm run build:structured-brain",
    "build:graph": "npm run build --prefix plugins/graph",
    "build:contribute": "npm run build --prefix plugins/contribute",
    "build:structured-brain": "npm run build --prefix plugins/structured-brain",
    "build:explicit": "npm run build",
    "publish:local": "npm run build",
    "ensure-plugin-index": "node scripts/ensure-plugin-index.mjs",
    "docs": "npx quartz build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "test:graph-links": "node scripts/check-hidden-graph-links.mjs",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "npm run ensure-plugin-index",
    "prebuild": "npm run build:plugins && node scripts/use-local-graph.mjs && npm run ensure-plugin-index"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@floating-ui/dom": "^1.7.6",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "0.1.22",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isomorphic-git": "^1.38.4",
    "lightningcss": "^1.32.0",
    "micromorph": "^0.4.5",
    "minimatch": "^10.2.5",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0",
    "pretty-bytes": "^7.1.0",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "serve-handler": "^6.1.7",
    "sharp": "^0.34.5",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.2",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.9.2",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
