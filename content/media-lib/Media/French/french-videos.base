formulas:
  duration: duration(duration + 's')
  subtitle: "[album, creator].filter(value.isTruthy()).join(' - ')"
properties:
  formula.duration:
    displayName: Duration
views:
  - type: mx-media-lib
    name: French Videos
    filters:
      and:
        - '!note["mx-uid"].isEmpty()'
        - note.captions.toString().contains("#lang=fr")
    order:
      - mx-uid
      - title
      - media
      - video
      - audio
      - formula.subtitle
      - formula.duration
    sort:
      - property: creator
        direction: ASC
      - property: title
        direction: ASC
    subtitleSource: formula.subtitle
    columnSize:
      info: 626
  - type: cards
    name: Cards
    filters:
      and:
        - '!note["mx-uid"].isEmpty()'
        - note.captions.toString().contains("#lang=fr")
    sort:
      - property: creator
        direction: ASC
      - property: title
        direction: ASC
    image: note.cover
    cardSize: 170
