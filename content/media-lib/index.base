filters:
  and:
    - '!note["mx-uid"].isEmpty()'
formulas:
  duration: duration(duration + 's')
  subtitle: "[album, creator].filter(value.isTruthy()).join(' - ')"
properties:
  formula.duration:
    displayName: Duration
views:
  - type: mx-media-lib
    name: Media Library
    filters:
      and:
        - '!note["mx-uid"].isEmpty()'
    order:
      - mx-uid
      - title
      - media
      - captions
      - formula.subtitle
      - formula.duration
      - audio
      - video
    sort:
      - property: creator
        direction: ASC
      - property: title
        direction: ASC
    subtitleSource: note.captions
    hideActions: false
    columnSize:
      formula.subtitle: 65
      info: 387
  - type: cards
    name: View
    sort:
      - property: creator
        direction: ASC
      - property: title
        direction: ASC
    image: note.cover
    cardSize: 120
    imageAspectRatio: 1
  - type: cards
    name: Movies
    filters:
      and:
        - file.size > 15000
    sort:
      - property: creator
        direction: ASC
      - property: title
        direction: ASC
    image: note.cover
    imageFit: contain
    imageAspectRatio: 0.6
    cardSize: 190
