filters:
  and:
    - file.tags.contains("japanese")
    - file.folder.containsAny("movies", "series", "Youtube")
formulas:
  duration: duration(duration + 's')
  subtitle: "[album, creator].filter(value.isTruthy()).join(' - ')"
  languageSignal: "[title, description, creator, file.name].filter(value.isTruthy()).join(' ')"
properties:
  formula.duration:
    displayName: Duration
views:
  - type: cards
    name: All
    groupBy:
      property: creator
      direction: ASC
    order:
      - title
    sort:
      - property: creator
        direction: ASC
      - property: title
        direction: ASC
    subtitleSource: formula.subtitle
    columnSize:
      info: 626
    hideCover: false
    image: note.cover
    cardSize: 150
    imageAspectRatio: 0.85
  - type: cards
    name: movies
    filters:
      and:
        - file.tags.contains("movie")
    groupBy:
      property: creator
      direction: ASC
    order:
      - file.name
      - publish
    image: note.cover
  - type: cards
    name: has vocabulary list
    filters:
      and:
        - file.tags.containsAll("vocabulary-list")
    order:
      - file.name
    image: note.cover
  - type: cards
    name: YT Videos
    filters:
      and:
        - file.tags.contains("japanese")
        - creator_url.contains("youtube")
    groupBy:
      property: creator
      direction: ASC
    image: note.cover
    cardSize: 80
  - type: cards
    name: music
    filters:
      and:
        - file.tags.contains("music")
    order:
      - file.name
    image: note.cover
  - type: cards
    name: Cards (looks beautiful, for display)
    filters:
      and:
        - stars > 5
    order:
      - file.name
    sort:
      - property: creator
        direction: ASC
    limit: 10
    cardSize: 130
    image: note.cover
    imageAspectRatio: 0.45
